# Credenciais da integração criada no painel CoinPayments (nunca use a senha da conta aqui)
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET=

# Use a instância indicada no painel: a, b, c ou sandbox
COINPAYMENTS_BASE_URL=https://a-api.coinpayments.net

# Deve ser exatamente a URL HTTPS pública cadastrada no CoinPayments
COINPAYMENTS_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/coinpayments

# BRL na API CoinPayments; o comprador escolhe a criptomoeda no checkout
COINPAYMENTS_INVOICE_CURRENCY=5203
APP_PUBLIC_URL=https://seu-dominio.com
