# 2PP (2pp.online): credenciais geradas em "Integração API" no painel
TWOPP_API_KEY=
TWOPP_API_SECRET=

# Host da API do 2PP mostrado no painel
TWOPP_BASE_URL=https://webhookxxx.2pp.online

# Segredo aleatório com pelo menos 32 caracteres; autentica o webhook de cada cobrança
TWOPP_WEBHOOK_TOKEN=

# URL HTTPS pública da aplicação (usada na URL de webhook informada ao 2PP)
APP_PUBLIC_URL=https://seu-dominio.com

# Segredo aleatório com pelo menos 16 caracteres; a Vercel envia no job diário das 09:00 (America/Sao_Paulo)
CRON_SECRET=
DATABASE_URL=

# Criados somente no primeiro início, quando ainda não existe banco persistido.
GOMOVE_ADMIN_USERNAME=admin
GOMOVE_ADMIN_EMAIL=admin@gomoveinfra.com.br
GOMOVE_ADMIN_NAME=Administrador GoMove
GOMOVE_ADMIN_PASSWORD=
GOMOVE_ADMIN_INVITE_CODE=gomove
# Usado apenas no desenvolvimento local sem DATABASE_URL.
GOMOVE_DATA_FILE=.data/db.json
