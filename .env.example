# Credenciais da integração criada no painel CoinPayments (nunca use a senha da conta aqui)
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET=

# Use a instância indicada no painel: a, b, c ou sandbox
COINPAYMENTS_BASE_URL=https://a-api.coinpayments.net

# Deve ser exatamente a URL HTTPS pública cadastrada no CoinPayments
COINPAYMENTS_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/coinpayments

# BRL na API CoinPayments; o comprador escolhe a criptomoeda no checkout
COINPAYMENTS_INVOICE_CURRENCY=5203
APP_PUBLIC_URL=https://seu-dominio.com

# PIXPAY: credenciais da Integração API. O token protege o webhook por cobrança.
PIXPAY_API_KEY=
PIXPAY_API_SECRET=
PIXPAY_BASE_URL=https://apixxxtentacion.pixpay.cloud
PIXPAY_WEBHOOK_TOKEN=

# Segredo aleatório com pelo menos 16 caracteres; a Vercel envia no job diário das 09:00 (America/Sao_Paulo)
CRON_SECRET=
DATABASE_URL=

# Criados somente no primeiro início, quando ainda não existe banco persistido.
GOMOVE_ADMIN_USERNAME=admin
GOMOVE_ADMIN_EMAIL=admin@gomoveinfra.com.br
GOMOVE_ADMIN_NAME=Administrador GoMove
GOMOVE_ADMIN_PASSWORD=
GOMOVE_ADMIN_INVITE_CODE=gomove
# Usado apenas no desenvolvimento local sem DATABASE_URL.
GOMOVE_DATA_FILE=.data/db.json
