{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-profitability",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/daily-profitability",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/daily-profitability",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-profitability",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
